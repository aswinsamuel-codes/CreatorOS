# Copy this file to ".env" and fill in your own values.
# .env is ignored by git, so your keys never get published.

# --- AI models (fill only the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Publishing ---
# Medium: Settings -> Security and apps -> Integration tokens
MEDIUM_TOKEN=
# Dev.to: Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=

# --- Telegram approval bot ---
# 1. Talk to @BotFather on Telegram, send /newbot, copy the token here.
# 2. Send any message to your new bot, then run:  python -m creatoros telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard (optional) ---
# Set this if you expose the dashboard on your network (e.g. the lab cluster).
# Then open http://<host>:8787/?token=<value>
DASHBOARD_TOKEN=
