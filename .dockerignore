# Keep secrets, personal data and dev files out of the image
.git
.github
.venv
venv
__pycache__
*.pyc
.env
config.local.yaml
data
logs
tests
docs
*.md
!profile/notes/README.md

# personal profile, notes and documents stay on your machine (mounted as a volume instead)
profile/profile.yaml
profile/notes/*
!profile/notes/README.md
profile/documents

# generated content and media
workspace/output/*
workspace/media
workspace/inbox
workspace/clips/*
workspace/references/*
workspace/music/*
workspace/voices/*
!workspace/**/.gitkeep
